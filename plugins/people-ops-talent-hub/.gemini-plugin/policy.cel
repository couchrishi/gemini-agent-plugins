version: '1.0'
plugin_id: people-ops-talent-hub
read_only_tools:
- workday_read_effective_roster
- greenhouse_read_scorecards
- sheets_read_unformatted
- view_file
- pyrepl
draft_only_tools:
- docs_create_debrief_pack
- docs_create_onboarding_checklist
- write_to_file
hitl_gated_mutations:
- tool: workday_propose_comp_change
  scope: explicit_per_call
  condition: request.compa_ratio > 0 || request.worker_count > 0
  reason: Compensation adjustments require Compensation Lead and HRBP approval.
- tool: greenhouse_advance_offer_stage
  scope: explicit_per_call
  condition: request.bias_flag_count > 0 || request.candidate_count >= 1
  reason: Hiring decisions and offer approvals must remain strictly human-owned.
cel_guardrails:
- id: enforce_hr_small_cell_privacy
  description: Require privacy redaction when department cohort size is below threshold.
  expr: privacy.min_cell_size >= 5
- id: block_auto_hire_with_bias_flags
  description: Prevent hire recommendation output whenever scorecard bias flags exist.
  expr: calibration.bias_flag_count == 0
