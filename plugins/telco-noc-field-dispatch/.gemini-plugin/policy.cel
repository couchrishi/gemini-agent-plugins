version: '1.0'
plugin_id: telco-noc-field-dispatch
read_only_tools:
- servicenow_read_em_alerts
- fsm_read_tech_certs_and_spares
- oss_read_b2b_fallout
- view_file
- pyrepl
draft_only_tools:
- servicenow_draft_parent_incident
- docs_create_noc_sitrep
- write_to_file
hitl_gated_mutations:
- tool: fsm_dispatch_truck_roll
  scope: explicit_per_call
  condition: request.ready_count >= 1
  reason: Dispatching field technicians and releasing depot spares requires Dispatch
    Coordinator HITL approval.
- tool: servicenow_bulk_suppress_child_alerts
  scope: explicit_per_call
  condition: request.symptom_alarms_suppressed > 0
  reason: Bulk-closing or linking NOC alerts requires Duty NOC Incident Commander
    sign-off.
cel_guardrails:
- id: block_dispatch_on_expired_cert_or_missing_spares
  description: Never dispatch blocked work orders lacking valid safety certs or spare
    hardware.
  expr: dispatch.blocked_count == 0 || dispatch.ready_count > 0
