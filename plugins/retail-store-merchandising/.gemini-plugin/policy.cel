version: '1.0'
plugin_id: retail-store-merchandising
read_only_tools:
- bigquery_query_pos_inventory
- sap_read_po_receipts
- view_file
- pyrepl
draft_only_tools:
- sheets_draft_store_task_list
- docs_create_vendor_scorecard
- write_to_file
hitl_gated_mutations:
- tool: erp_post_inventory_writeoff
  scope: explicit_per_call
  condition: request.total_shrink_usd > 0
  reason: Posting perpetual inventory write-offs alters financial COGS and requires
    Store/Inventory Controller approval.
- tool: ap_issue_vendor_chargeback_debit
  scope: explicit_per_call
  condition: request.total_chargebacks_usd > 0
  reason: Issuing vendor OTIF debit memos requires Merchandising & Vendor Ops HITL
    sign-off.
cel_guardrails:
- id: block_unpolled_store_phantom_flags
  description: Never emit perpetual write-off recommendations for stores whose POS
    polling status is MISSING.
  expr: store.unpolled_pos_skipped >= 0
