version: "1.0"
plugin_id: finance-variance-recon
read_only_tools:
  - sap_read_invoice_and_po
  - bigquery_query_gl_summary
  - sheets_read_unformatted
  - view_file
  - pyrepl
draft_only_tools:
  - docs_create_close_memo_draft
  - sheets_write_exception_tab
  - write_to_file
hitl_gated_mutations:
  - tool: sap_post_invoice_payment
    scope: explicit_per_call
    condition: "request.invoice_amount_usd > 0 || request.exception_count > 0"
    reason: Posting AP invoices or releasing payment blocks in ERP requires explicit Controller approval.
  - tool: erp_update_vendor_bank_master
    scope: explicit_per_call
    condition: "request.bank_account_changed == true"
    reason: Vendor remittance / bank master changes must never occur from email instructions without out-of-band treasury verification.
  - tool: gmail_send_dunning_notice
    scope: explicit_per_call
    condition: "request.is_external_recipient == true"
    reason: Sending external AR dunning notices to customers requires Finance Lead sign-off.
cel_guardrails:
  - id: block_payment_on_bank_change_or_duplicate
    description: Halt automatic AP clearance whenever a bank account change flag or duplicate suspect exists.
    expr: "ap.duplicate_suspect == false && ap.bank_account_changed == false"
  - id: require_leaf_hierarchy_tieout
    description: Block executive P&L variance release if summary totals diverge from leaf sums beyond tolerance.
    expr: "pnl.hierarchy_break_count == 0"
