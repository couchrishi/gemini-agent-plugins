version: "1.0"
plugin_id: sdlc-modernization-sre
read_only_tools:
  - github_read_pr_diff
  - gitlab_read_mr_diff
  - cloud_logging_query
  - jira_jql_search
  - view_file
  - pyrepl
draft_only_tools:
  - docs_create_postmortem_draft
  - docs_create_prd_draft
  - write_to_file
hitl_gated_mutations:
  - tool: github_merge_or_approve_pr
    scope: explicit_per_call
    condition: "request.critical_security_findings > 0 || request.action in ['merge', 'approve', 'push']"
    reason: Merging PRs or submitting code approvals requires explicit engineer confirmation.
  - tool: jira_bulk_create_remediation_tickets
    scope: task_sticky
    condition: "request.ticket_count >= 1"
    reason: Creating postmortem remediation tickets in Jira requires owner approval.
  - tool: database_apply_migration
    scope: explicit_per_call
    condition: "request.destructive_ddl == true || request.environment == 'production'"
    reason: Applying schema migrations in production or staging requires explicit DBA/SRE approval.
cel_guardrails:
  - id: block_pr_with_secrets_or_dropped_auth
    description: Block PR merge readiness whenever hardcoded secrets or removed auth decorators are detected.
    expr: "pr.secret_finding_count == 0 && pr.removed_authz_count == 0"
  - id: verify_slo_budget_math
    description: Ensure postmortem timelines include valid non-negative TTD, TTM, and TTR intervals.
    expr: "postmortem.ttr_minutes >= 0.0 && postmortem.slo_target_pct > 90.0"
