version: '1.0'
plugin_id: gsi-proposal-ip-factory
read_only_tools:
- drive_read_sow_draft
- workday_read_bench_roster
- sheets_read_unformatted
- view_file
- pyrepl
draft_only_tools:
- docs_create_proposal_draft
- slides_draft_solution_deck
- write_to_file
hitl_gated_mutations:
- tool: psa_submit_sow_for_bid_review
  scope: explicit_per_call
  condition: request.gross_margin_pct < 30.0 || request.blocker_count > 0
  reason: Submitting below-margin or scope-risk SOWs requires Practice VP and Finance
    approval.
- tool: psa_assign_bench_resource
  scope: task_sticky
  condition: request.demands_evaluated >= 1
  reason: Allocating consultants to client projects requires Resource Manager confirmation.
cel_guardrails:
- id: block_sow_below_hard_margin
  description: Block SOW submission when gross margin falls below 20% hard floor.
  expr: sow.gross_margin_pct >= 20.0
