version: '1.0'
plugin_id: brand-campaign-studio
read_only_tools:
- drive_read_brand_kit
- smartling_read_translations
- docs_read_tabs
- view_file
- pyrepl
draft_only_tools:
- docs_create_campaign_brief
- slides_draft_creative_deck
- write_to_file
hitl_gated_mutations:
- tool: cms_publish_campaign_asset
  scope: explicit_per_call
  condition: request.blocked_count > 0 || request.is_public_channel == true
  reason: Publishing public marketing copy or paid ads requires Brand & Legal approval.
cel_guardrails:
- id: block_publish_with_prohibited_claims
  description: Prevent campaign launch when copy contains banned claims or missing
    disclaimers.
  expr: lint.blocked_count == 0
