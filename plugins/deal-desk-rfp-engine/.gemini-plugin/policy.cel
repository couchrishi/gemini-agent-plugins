version: "1.0"
plugin_id: deal-desk-rfp-engine
read_only_tools:
  - salesforce_soql_query
  - drive_read_sheet
  - view_file
  - pyrepl
draft_only_tools:
  - sheets_create_rfp_response_draft
  - docs_create_deal_memo_draft
  - write_to_file
hitl_gated_mutations:
  - tool: salesforce_update_opportunity_or_quote
    scope: explicit_per_call
    condition: "request.changes_forecast_category == true || request.discount_pct > config.auto_approve_max_discount_pct || request.bulk_count > 1"
    reason: Updating CRM forecast categories, close dates, or discounted quotes requires explicit user approval.
  - tool: deal_desk_submit_or_approve_quote
    scope: explicit_per_call
    condition: "request.approval_tier != 'Tier 0: Auto-Approved' || request.gross_margin_pct < config.min_gross_margin_floor_pct"
    reason: Escalated Deal Desk quotes and margin exceptions require explicit approver sign-off.
  - tool: portal_submit_rfp_response
    scope: explicit_per_call
    condition: "request.is_external_submission == true || request.mandatory_gap_count > 0 || untrusted_content.detected == true"
    reason: Submitting customer RFP packets externally requires explicit human review, especially with open gaps.
cel_guardrails:
  - id: require_fx_conversion_on_mixed_currencies
    description: Block summing nominal CRM amounts across mixed currencies without FX conversion.
    expr: "pipeline.has_mixed_currencies == false || pipeline.fx_normalized == true"
  - id: quarantine_untrusted_rfp_prompts
    description: Isolate customer RFP rows containing indirect prompt injection attempts.
    expr: "untrusted_content.detected == true"
