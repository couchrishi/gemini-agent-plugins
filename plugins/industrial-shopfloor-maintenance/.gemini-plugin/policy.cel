version: '1.0'
plugin_id: industrial-shopfloor-maintenance
read_only_tools:
- sap_read_maintenance_history
- bigquery_query_qms_scrap
- ehs_read_ptw_forms
- view_file
- pyrepl
draft_only_tools:
- docs_create_capex_request
- sheets_draft_reorder_requisition
- write_to_file
hitl_gated_mutations:
- tool: sap_create_spares_pr
  scope: explicit_per_call
  condition: request.total_recommended_spend_usd > 0
  reason: Releasing spare parts purchase requisitions requires Plant Maintenance Manager
    approval.
- tool: ehs_authorize_permit_to_work
  scope: explicit_per_call
  condition: request.stop_work_blocked_count == 0
  reason: Signing live Permit-to-Work authorizations always requires a certified EHS
    Area Authority on-site.
cel_guardrails:
- id: halt_permit_on_safety_defect
  description: Block Permit-to-Work issuance unconditionally whenever STOP_WORK_BLOCKED
    permits exist.
  expr: ehs.stop_work_blocked_count == 0
