version: '1.0'
plugin_id: fsi-credit-kyc-claims
read_only_tools:
- bigquery_query_credit_spread
- kyb_read_corporate_tree
- claims_read_policy_terms
- view_file
- pyrepl
draft_only_tools:
- docs_create_credit_memo
- docs_draft_sar_narrative
- write_to_file
hitl_gated_mutations:
- tool: credit_commit_loan_decision
  scope: explicit_per_call
  condition: request.borrowers_evaluated >= 1 || request.base_breach_count > 0
  reason: Credit underwriting decisions and covenant waivers require Credit Committee
    approval.
- tool: aml_file_sar_or_block_account
  scope: explicit_per_call
  condition: request.velocity_spike_alert == true || request.structuring_alert ==
    true
  reason: Filing SARs or freezing customer accounts requires MLRO Compliance Officer
    sign-off.
- tool: claims_issue_settlement_payout
  scope: explicit_per_call
  condition: request.total_net_payable_usd > 0
  reason: Disbursing claim settlements requires Senior Claims Adjuster approval.
cel_guardrails:
- id: block_auto_credit_approval_on_breach
  description: Halt credit approval whenever base or stress scenarios breach hard
    DSCR/leverage limits.
  expr: credit.base_breach_count == 0
- id: enforce_edd_on_pep_or_high_risk
  description: Ensure AML EDD escalation flag fires whenever PEP or high-risk jurisdiction
    exists.
  expr: kyc.edd_triggered == false || kyc.ubo_threshold_applied_pct <= 10.0
