{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/couchrishi/gemini-agent-plugins/shared/schema/eval.schema.json",
  "title": "Gemini Agent Skill Evaluation Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill_id",
    "plugin_id",
    "version",
    "deterministic_checks",
    "scenarios",
    "rubric"
  ],
  "properties": {
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "plugin_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "deterministic_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_script",
        "required_output_keys",
        "must_include_patterns",
        "must_not_include_patterns",
        "hitl_required_for_mutations",
        "trap_checks"
      ],
      "properties": {
        "expected_script": {
          "type": "string",
          "pattern": "^scripts/[a-z0-9_]+\\.py$"
        },
        "required_output_keys": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "must_include_patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "must_not_include_patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hitl_required_for_mutations": {
          "type": "boolean"
        },
        "trap_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mode",
          "prompt",
          "expected_assertions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "live_connector",
              "workspace_connector",
              "local_file"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 20
          },
          "expected_assertions": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 5
            }
          }
        }
      }
    },
    "rubric": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "weight",
          "description"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 3
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "description": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  }
}
