{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/couchrishi/gemini-agent-plugins/shared/schema/plugin.schema.json",
  "title": "Gemini Agent Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "category",
    "segment_tags",
    "description",
    "skills",
    "shared_traps",
    "shared_baselines",
    "agent_templates",
    "schedules",
    "license"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "category": {
      "type": "string",
      "enum": ["horizontal", "enterprise-ops", "vertical"]
    },
    "segment_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 600
    },
    "skills": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "script", "summary"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "maxLength": 64
          },
          "script": {
            "type": "string",
            "pattern": "^scripts/[a-z0-9_]+\\.py$"
          },
          "summary": {
            "type": "string",
            "minLength": 10,
            "maxLength": 240
          }
        }
      }
    },
    "shared_traps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+\\.md$"
      }
    },
    "shared_baselines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+\\.md$"
      }
    },
    "agent_templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^agents/[a-z0-9-]+\\.yaml$"
      }
    },
    "schedules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^schedules/[a-z0-9-]+\\.yaml$"
      }
    },
    "license": {
      "type": "string",
      "const": "Apache-2.0"
    }
  }
}
