{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/couchrishi/gemini-agent-plugins/shared/schema/plugin.schema.json",
  "title": "Gemini Agent Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "category",
    "segment_tags",
    "description",
    "license",
    "skills",
    "shared_traps",
    "shared_baselines",
    "connectors",
    "write_governance",
    "scheduled_routine"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "category": {
      "type": "string",
      "enum": [
        "horizontal",
        "enterprise-ops",
        "vertical"
      ]
    },
    "segment_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 600
    },
    "license": {
      "type": "string",
      "const": "Apache-2.0"
    },
    "skills": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "script",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "maxLength": 64
          },
          "script": {
            "type": "string",
            "pattern": "^scripts/[a-z0-9_]+\\.py$"
          },
          "summary": {
            "type": "string",
            "minLength": 10,
            "maxLength": 240
          }
        }
      }
    },
    "shared_traps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+\\.md$"
      }
    },
    "shared_baselines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+\\.md$"
      }
    },
    "connectors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managed_1p",
        "connector_fetch_guidance"
      ],
      "properties": {
        "managed_1p": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "Google Drive",
              "Google Sheets",
              "Google Docs",
              "Google Slides",
              "Gmail",
              "Google Calendar",
              "Microsoft 365 (SharePoint, OneDrive, Outlook, Teams)",
              "BigQuery",
              "Salesforce",
              "ServiceNow",
              "Jira",
              "Confluence",
              "Slack",
              "GitHub",
              "Box",
              "Snowflake",
              "Postgres"
            ]
          }
        },
        "byo_mcp": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          }
        },
        "connector_fetch_guidance": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500
        }
      }
    },
    "write_governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateway_approval_actions",
        "python_code_guardrails"
      ],
      "properties": {
        "gateway_approval_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 260
          }
        },
        "python_code_guardrails": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 260
          }
        }
      }
    },
    "scheduled_routine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "cron_expression",
        "time_zone",
        "instruction"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "cron_expression": {
          "type": "string",
          "minLength": 9,
          "maxLength": 64
        },
        "time_zone": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "instruction": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1200
        }
      }
    }
  }
}
